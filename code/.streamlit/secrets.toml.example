# Copy to `secrets.toml` in this folder (do not commit real keys).
# Streamlit reads `.streamlit/secrets.toml` when you run `streamlit run app.py`.

ANTHROPIC_API_KEY = "sk-ant-api03-..."

# Optional: override model id
# ANTHROPIC_MODEL = "claude-3-5-sonnet-20241022"

# Google Drive — interview JSON on "End interview" (OAuth recommended)
# GOOGLE_DRIVE_FOLDER_ID = "your-folder-id"
# GOOGLE_DRIVE_OAUTH_CLIENT_ID = "..."
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET = "..."
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN = "..."

# Or service account (share the folder with the service account email)
# GOOGLE_DRIVE_FOLDER_ID = "your-folder-id"
# GOOGLE_DRIVE_CREDENTIALS_JSON = '{"type":"service_account",...}'
