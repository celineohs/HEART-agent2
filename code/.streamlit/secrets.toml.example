# Copy to `secrets.toml` in this folder (do not commit real keys).
# Streamlit reads `.streamlit/secrets.toml` when you run `streamlit run app.py`.

ANTHROPIC_API_KEY = "sk-ant-api03-..."

# Optional: override model id
# ANTHROPIC_MODEL = "claude-3-5-sonnet-20241022"

# --- Google Drive (interview JSON backup on completion) ---

# RECOMMENDED: OAuth — uploads to a folder in YOUR Google Drive
# (Service accounts cannot write to personal My Drive; Google returns storageQuotaExceeded.)
#
# 1. Cloud Console: enable Drive API, create OAuth client (Desktop)
# 2. Run: pip install google-auth-oauthlib && python generate_drive_refresh_token.py
# 3. Create a folder in My Drive; copy its id from the URL
GOOGLE_DRIVE_FOLDER_ID = "your-folder-id"
GOOGLE_DRIVE_OAUTH_CLIENT_ID = "....apps.googleusercontent.com"
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET = "...."
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN = "...."

# ALTERNATIVE: Service account — only works with a Google Workspace SHARED DRIVE folder
# (not a normal folder shared to the service account email on personal Drive)
# GOOGLE_DRIVE_FOLDER_ID = "shared-drive-folder-id"
# GOOGLE_DRIVE_CREDENTIALS_JSON = '{"type":"service_account",...}'
